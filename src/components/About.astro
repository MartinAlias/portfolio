---
import { profile, certifications, education } from '../data/site';

const earned = certifications.filter((c) => c.status === 'earned').map((c) => c.name.replace(/.*\((.+)\)$/, '$1'));
const glance = [
  { k: 'Role', v: profile.title },
  { k: 'Based in', v: profile.location },
  { k: 'Experience', v: '5+ years: infrastructure, security, full stack' },
  ...(education[0] ? [{ k: 'Education', v: `${education[0].credential}, ${education[0].school}` }] : []),
  ...(earned.length ? [{ k: 'Certified', v: earned.join(', ') }] : []),
  { k: 'Building', v: 'LabWarden, AI Race Engineer' },
  { k: 'Principle', v: 'Read-only by default; humans approve changes' },
];
---

<section class="first">
  <div class="container about">
    <div>{profile.about.map((p) => <p class="para">{p}</p>)}</div>
    <aside class="card" aria-label="At a glance">
      <dl>
        {
          glance.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1.6fr 1fr;
      gap: 48px;
    }
  }
  .para {
    color: var(--muted);
    max-width: 68ch;
    margin: 0 0 18px;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  dt {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  dd {
    margin: 2px 0 0;
  }
</style>
