---
import { homelab } from '../data/site';

// Topology: internet → router → switch, which branches to the server
// (drawn as a container holding its VMs and containers) and the other devices.
const { server, guests, devices } = homelab.diagram;
const W = 640;
const busY = 214;
const top = 230;

// Server container on the left, guests in a 2-column grid inside it.
const srv = { x: 10, w: 300 };
const chipW = (srv.w - 30) / 2;
const chipH = 44;
const chipX = (i: number) => srv.x + 10 + (i % 2) * (chipW + 10);
const chipY = (i: number) => top + 44 + Math.floor(i / 2) * (chipH + 8);
const srvH = 44 + Math.ceil(guests.length / 2) * (chipH + 8) + 2;

// Other devices share the remaining width to the right.
const devX0 = srv.x + srv.w + 20;
const devGap = 12;
const devW = devices.length ? (W - 10 - devX0 - devGap * (devices.length - 1)) / devices.length : 0;
const devX = (i: number) => devX0 + i * (devW + devGap);

const drops = [srv.x + srv.w / 2, ...devices.map((_, i) => devX(i) + devW / 2)];
const H = top + srvH + 10;
---

<section class="first">
  <div class="container">

    <div class="lab">
      <div class="card diagram">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="topo-title">
          <title id="topo-title">
            Home lab network: internet to router to switch, which connects the {server.name.toLowerCase()} ({guests.map((g) => g.name).join(', ')}) and {devices.map((d) => `${d.name} (${d.note})`).join(', ')}
          </title>
          <g class="edge">
            <line x1={W / 2} y1="44" x2={W / 2} y2="80"></line>
            <line x1={W / 2} y1="124" x2={W / 2} y2="160"></line>
            <line x1={W / 2} y1="196" x2={W / 2} y2={busY}></line>
            <line x1={drops[0]} y1={busY} x2={drops[drops.length - 1]} y2={busY}></line>
            {drops.map((x) => <line x1={x} y1={busY} x2={x} y2={top}></line>)}
          </g>
          <g class="node muted">
            <rect x={W / 2 - 70} y="8" width="140" height="36" rx="8"></rect>
            <text x={W / 2} y="31">Internet</text>
          </g>
          <g class="node strong">
            <rect x={W / 2 - 90} y="80" width="180" height="44" rx="8"></rect>
            <text x={W / 2} y="100">Router</text>
            <text class="sub" x={W / 2} y="116">internet gateway</text>
          </g>
          <g class="node">
            <rect x={W / 2 - 80} y="160" width="160" height="36" rx="8"></rect>
            <text x={W / 2} y="183">Switch</text>
          </g>

          <g class="node server">
            <rect x={srv.x} y={top} width={srv.w} height={srvH} rx="10"></rect>
            <text x={srv.x + srv.w / 2} y={top + 20}>{server.name}</text>
            <text class="sub" x={srv.x + srv.w / 2} y={top + 34}>{server.note}</text>
          </g>
          {
            guests.map((g, i) => (
              <g class={`node guest ${g.kind}`}>
                <rect x={chipX(i)} y={chipY(i)} width={chipW} height={chipH} rx="6"></rect>
                <text x={chipX(i) + chipW / 2} y={chipY(i) + 19}>{g.name}</text>
                <text class="sub" x={chipX(i) + chipW / 2} y={chipY(i) + 34}>{g.note}</text>
              </g>
            ))
          }
          {
            devices.map((d, i) => (
              <g class="node device">
                <rect x={devX(i)} y={top} width={devW} height="56" rx="8"></rect>
                <text x={devX(i) + devW / 2} y={top + 23}>{d.name}</text>
                <text class="sub" x={devX(i) + devW / 2} y={top + 41}>{d.note}</text>
              </g>
            ))
          }
        </svg>
      </div>

      <div class="lists">
        <div class="card">
          <h3>Hardware</h3>
          <dl>
            {
              homelab.hardware.map((h) => (
                <div>
                  <dt>{h.name}</dt>
                  <dd>{h.detail}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="card">
          <h3>Services</h3>
          <ul class="tags">{homelab.services.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lab {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 960px) {
    .lab {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .diagram {
    display: flex;
    align-items: center;
  }
  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .edge line,
  .edge path {
    stroke: var(--border);
    stroke-width: 2;
  }
  .node rect {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .node.strong rect {
    stroke: var(--accent);
  }
  .node.server rect,
  .node.device rect {
    stroke: var(--accent-2);
  }
  .node.guest rect {
    fill: var(--accent-soft);
  }
  .node.guest.vuln rect {
    stroke: var(--warn);
  }
  .node.guest.wip rect {
    stroke: var(--accent);
    stroke-dasharray: 4 3;
  }
  .node.muted rect {
    stroke-dasharray: 4 4;
  }
  .node text {
    fill: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    text-anchor: middle;
  }
  .node text.sub {
    fill: var(--muted);
    font-size: 10px;
  }
  .lists {
    display: grid;
    gap: 20px;
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 12px;
    font-family: var(--mono);
    color: var(--accent);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  dt {
    font-weight: 600;
    font-size: 0.95rem;
  }
  dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
