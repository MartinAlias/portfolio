---
import { homelab } from '../data/site';

// Simple topology: internet → firewall → switch → one box per VLAN.
const vlans = homelab.vlans;
const W = 640;
const boxW = 130;
const gap = vlans.length > 1 ? (W - 20 - boxW * vlans.length) / (vlans.length - 1) : 0;
const xs = vlans.map((_, i) => 10 + i * (boxW + gap));
---

<section id="homelab">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">// infrastructure</span>
      <h2>Home Lab</h2>
      <p>{homelab.intro}</p>
    </div>

    <div class="lab">
      <div class="card diagram">
        <svg viewBox={`0 0 ${W} 300`} role="img" aria-labelledby="topo-title">
          <title id="topo-title">Home lab network: internet to firewall to switch, then {vlans.length} VLAN segments</title>
          <g class="edge">
            <line x1={W / 2} y1="44" x2={W / 2} y2="80"></line>
            <line x1={W / 2} y1="124" x2={W / 2} y2="160"></line>
            {xs.map((x) => <path d={`M${W / 2} 196 V214 H${x + boxW / 2} V230`} fill="none"></path>)}
          </g>
          <g class="node muted">
            <rect x={W / 2 - 70} y="8" width="140" height="36" rx="8"></rect>
            <text x={W / 2} y="31">Internet</text>
          </g>
          <g class="node strong">
            <rect x={W / 2 - 90} y="80" width="180" height="44" rx="8"></rect>
            <text x={W / 2} y="100">Firewall / Router</text>
            <text class="sub" x={W / 2} y="116">inter-VLAN policy</text>
          </g>
          <g class="node">
            <rect x={W / 2 - 80} y="160" width="160" height="36" rx="8"></rect>
            <text x={W / 2} y="183">Managed switch</text>
          </g>
          {
            vlans.map((v, i) => (
              <g class="node vlan">
                <rect x={xs[i]} y="230" width={boxW} height="56" rx="8"></rect>
                <text x={xs[i] + boxW / 2} y="252">VLAN {v.id} · {v.name}</text>
                <text class="sub" x={xs[i] + boxW / 2} y="272">{v.note}</text>
              </g>
            ))
          }
        </svg>
      </div>

      <div class="lists">
        <div class="card">
          <h3>Hardware</h3>
          <dl>
            {
              homelab.hardware.map((h) => (
                <div>
                  <dt>{h.name}</dt>
                  <dd>{h.detail}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="card">
          <h3>Services</h3>
          <ul class="tags">{homelab.services.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lab {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 960px) {
    .lab {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .edge line,
  .edge path {
    stroke: var(--border);
    stroke-width: 2;
  }
  .node rect {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .node.strong rect {
    stroke: var(--accent);
  }
  .node.vlan rect {
    stroke: var(--accent-2);
  }
  .node.muted rect {
    stroke-dasharray: 4 4;
  }
  .node text {
    fill: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    text-anchor: middle;
  }
  .node text.sub {
    fill: var(--muted);
    font-size: 10px;
  }
  .lists {
    display: grid;
    gap: 20px;
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 12px;
    font-family: var(--mono);
    color: var(--accent);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  dt {
    font-weight: 600;
    font-size: 0.95rem;
  }
  dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
