---
import { projects } from '../data/site';
---

<div class="others">
  <h3 class="sub">Other projects</h3>
  <div class="grid">
    {
      projects.map((p) => (
        <article class="card">
          <header>
            <h4>{p.name}</h4>
            <span class="year">{p.year}</span>
          </header>
          <p>{p.description}</p>
          <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
          <p class="links">
            {p.repo && <a href={p.repo} rel="noopener">Source ↗</a>}
            {p.live && <a href={p.live} rel="noopener">Live ↗</a>}
          </p>
        </article>
      ))
    }
  </div>
</div>

<style>
  .others {
    margin-top: 56px;
  }
  .sub {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  article {
    display: flex;
    flex-direction: column;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h4 {
    margin: 0;
    font-size: 1.1rem;
  }
  .year {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  p {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 10px 0 14px;
  }
  .links {
    margin: auto 0 0;
    padding-top: 14px;
    display: flex;
    gap: 16px;
    font-family: var(--mono);
    font-size: 0.85rem;
  }
</style>
