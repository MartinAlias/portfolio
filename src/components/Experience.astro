---
import { experience } from '../data/site';
---

<ol class="timeline">
  {
    experience.map((e) => (
      <li>
        <div class="when">
          {e.period}
          <span class="where">{e.location}</span>
        </div>
        <div class="what">
          <h3>{e.role}</h3>
          <p class="org">{e.org}</p>
          <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
          <ul class="tags">{e.tech.map((t) => <li>{t}</li>)}</ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  .timeline > li {
    position: relative;
    padding: 0 0 40px 24px;
    display: grid;
    gap: 6px;
  }
  .timeline > li:last-child {
    padding-bottom: 8px;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  @media (min-width: 760px) {
    .timeline > li {
      grid-template-columns: 190px 1fr;
      gap: 24px;
    }
  }
  .when {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--text);
    padding-top: 2px;
  }
  .where {
    display: block;
    color: var(--muted);
  }
  h3 {
    font-size: 1.15rem;
  }
  .org {
    margin: 2px 0 0;
    color: var(--accent-2);
    font-weight: 500;
  }
  .points {
    margin: 12px 0 14px;
    padding-left: 18px;
    color: var(--muted);
  }
  .points li + li {
    margin-top: 6px;
  }
</style>
