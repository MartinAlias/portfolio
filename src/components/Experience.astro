---
import { experience } from '../data/site';
---

<section id="experience">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">// history</span>
      <h2>Experience & education</h2>
    </div>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li>
            <div class="when">{e.period}</div>
            <div class="what">
              <h3>
                {e.role} <span class="org">· {e.org}</span>
              </h3>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  .timeline > li {
    position: relative;
    padding: 0 0 32px 24px;
    display: grid;
    gap: 4px;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  @media (min-width: 760px) {
    .timeline > li {
      grid-template-columns: 180px 1fr;
      gap: 24px;
    }
  }
  .when {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    padding-top: 2px;
  }
  h3 {
    font-size: 1.08rem;
  }
  .org {
    color: var(--muted);
    font-weight: 500;
  }
  .what ul {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--muted);
  }
  .what li + li {
    margin-top: 4px;
  }
</style>
