---
import { profile, links } from '../data/site';
---

<div class="hero" id="top">
  <div class="container">
    {profile.openToWork && <p class="status"><span class="dot" aria-hidden="true"></span>Open to cybersecurity & AI roles</p>}
    <h1>
      {profile.name}
      <span class="role">{profile.title}</span>
    </h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="cta">
      <a class="btn primary" href="#projects">View projects</a>
      <a class="btn" href="#contact">Get in touch</a>
      {links.resume && <a class="btn" href={links.resume} download>Resume (PDF)</a>}
    </div>
    <ul class="meta">
      {profile.location && <li>{profile.location}</li>}
      <li><a href={links.github} rel="noopener">github.com/{profile.handle}</a></li>
      {links.linkedin && <li><a href={links.linkedin} rel="noopener">LinkedIn</a></li>}
    </ul>
  </div>
</div>

<style>
  .hero {
    padding: 96px 0 80px;
    background:
      radial-gradient(700px 300px at 85% 0%, var(--accent-soft), transparent 70%),
      linear-gradient(transparent 0 0);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 24px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    letter-spacing: -0.02em;
  }
  .role {
    display: block;
    font-size: clamp(1.15rem, 3vw, 1.6rem);
    font-family: var(--mono);
    font-weight: 500;
    color: var(--accent);
    margin-top: 12px;
    letter-spacing: 0;
  }
  .tagline {
    max-width: 60ch;
    font-size: 1.12rem;
    color: var(--muted);
    margin: 20px 0 28px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
