---
import { links, profile } from '../data/site';

const channels = [
  links.email && { label: 'Email', value: links.email, href: `mailto:${links.email}` },
  links.phone && { label: 'Phone', value: links.phone, href: `tel:+1${links.phone.replace(/\D/g, '')}` },
  links.linkedin && { label: 'LinkedIn', value: links.linkedin.replace(/^https:\/\/(www\.)?/, ''), href: links.linkedin },
  { label: 'GitHub', value: `github.com/${profile.handle}`, href: links.github },
  links.resume && { label: 'Resume', value: 'Download PDF', href: links.resume },
  profile.location && { label: 'Location', value: profile.location },
].filter(Boolean) as { label: string; value: string; href?: string }[];
---

<section class="first">
  <div class="container">
    <ul class="channels">
      {
        channels.map((c) =>
          c.href ? (
            <li>
              <a class="card" href={c.href} rel="noopener">
                <span class="label">{c.label}</span>
                <span class="value">{c.value}</span>
              </a>
            </li>
          ) : (
            <li>
              <div class="card">
                <span class="label">{c.label}</span>
                <span class="value">{c.value}</span>
              </div>
            </li>
          )
        )
      }
    </ul>
  </div>
</section>

<style>
  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }
  .channels .card {
    display: grid;
    gap: 4px;
    color: var(--text);
    height: 100%;
  }
  .channels a:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .label {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .value {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
