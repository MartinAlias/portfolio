---
import { skills, certifications } from '../data/site';

const statusLabel = { earned: 'Earned', 'in-progress': 'In progress', planned: 'Planned' } as const;
---

<section id="skills">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">// toolkit</span>
      <h2>Skills & certifications</h2>
    </div>
    <div class="skills">
      {
        skills.map((s) => (
          <div class="card">
            <h3>{s.group}</h3>
            <ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))
      }
    </div>

    {
      certifications.length > 0 && (
        <ul class="certs">
          {certifications.map((c) => (
            <li class="card">
              <span class={`badge ${c.status}`}>{statusLabel[c.status]}</span>
              <div>
                <strong>{c.url ? <a href={c.url} rel="noopener">{c.name}</a> : c.name}</strong>
                <span class="issuer">
                  {c.issuer}
                  {c.date && ` · ${c.date}`}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  h3 {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .certs li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
  }
  .issuer {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .badge {
    flex: none;
    font-family: var(--mono);
    font-size: 0.7rem;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid currentColor;
  }
  .badge.earned {
    color: var(--accent);
  }
  .badge.in-progress {
    color: var(--warn);
  }
  .badge.planned {
    color: var(--muted);
  }
</style>
